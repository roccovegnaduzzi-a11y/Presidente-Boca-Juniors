{
  "name": "bot-tiktok-boca-presidente",
  "version": "1.0.0",
  "private": true,
  "description": "Arma videos de Boca Presidente para TikTok: guion con IA, voz en off, subtítulos, edición con ffmpeg y subida por la API de TikTok.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "video": "node src/main.mjs",
    "autorizar": "node src/autorizar.mjs",
    "prueba": "node src/main.mjs --guion ejemplos/guion-ejemplo.json --voz ninguna --url ejemplos/juego-de-prueba.html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "playwright": "1.63.0"
  }
}
